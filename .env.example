PORT=8080
ADMIN_PASSWORD=troque-esta-senha

# Produção (Docker/Dokploy) — use PostgreSQL:
DATABASE_URL=postgres://bolao:bolao@db:5432/bolao

# Desenvolvimento local sem Docker — omita DATABASE_URL ou deixe vazio
# e o servidor usa SQLite automaticamente (arquivo bolao.db na raiz do projeto).
# Caminho opcional do arquivo SQLite:
# SQLITE_PATH=./bolao.db
